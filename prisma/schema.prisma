// Certiora — Multi-tenant EdTech assessment platform
// Prisma schema per architecture blueprint

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— Enums ———

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ
}

enum QuestionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
}

enum SourceMaterialStatus {
  UPLOADED
  PROCESSING
  CHUNKED
  FAILED
}

enum IngestionJobType {
  CHUNK
  GENERATE_QUESTIONS
}

enum IngestionJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ExamType {
  SHORT_QUIZ
  QUICK_EXAM
  MOCK_EXAM
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

// ——— Tenancy and users ———

model Tenant {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  logoUrl      String?
  primaryColor String?
  customDomain String?  @unique
  settings     Json?    // tenant-specific settings
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users            User[]
  subjects         Subject[]
  questions        Question[]
  sourceMaterials  SourceMaterial[]
  ingestionJobs    IngestionJob[]
  examDefinitions  ExamDefinition[]
  examAttempts     ExamAttempt[]
  srsCards         SrsCard[]
  topicPerformance TopicPerformanceSnapshot[]
}

model User {
  id        String   @id @default(cuid())
  email     String
  name      String?
  image     String?
  tenantId  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts          Account[]
  sessions          Session[]
  questionsCreated  Question[]       @relation("CreatedBy")
  questionsApproved Question[]       @relation("ApprovedBy")
  sourceMaterials   SourceMaterial[]
  examAttempts      ExamAttempt[]
  srsCards          SrsCard[]
  topicPerformance  TopicPerformanceSnapshot[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ——— Question bank and taxonomy ———

model Subject {
  id       String   @id @default(cuid())
  tenantId String
  name     String
  order    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  topics   Topic[]
  questions Question[]

  @@index([tenantId])
}

model Topic {
  id        String   @id @default(cuid())
  tenantId  String
  subjectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subtopics Subtopic[]
  questions Question[]
  topicPerformance TopicPerformanceSnapshot[]

  @@index([tenantId])
  @@index([subjectId])
}

model Subtopic {
  id        String   @id @default(cuid())
  tenantId  String
  topicId   String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([tenantId])
  @@index([topicId])
}

model Question {
  id                    String            @id @default(cuid())
  tenantId               String
  subjectId              String
  topicId                String
  subtopicId             String?
  difficulty             QuestionDifficulty
  type                   QuestionType     @default(MCQ)
  stem                   String           @db.Text
  options                Json             // [{ id, text, isCorrect }]
  explanation            String?          @db.Text
  metadata               Json?
  sourceMaterialChunkId  String?
  status                 QuestionStatus   @default(DRAFT)
  createdBy              String?
  approvedBy             String?
  approvedAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Restrict)
  subtopic     Subtopic?     @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  sourceChunk  SourceChunk?  @relation(fields: [sourceMaterialChunkId], references: [id], onDelete: SetNull)
  creator      User?         @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  approver     User?         @relation("ApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  tags         QuestionTag[]
  attemptAnswers ExamAttemptAnswer[]
  srsCards     SrsCard[]

  @@index([tenantId, status])
  @@index([tenantId, subjectId, topicId])
  @@index([tenantId, difficulty])
  @@index([sourceMaterialChunkId])
}

model QuestionTag {
  id         String   @id @default(cuid())
  questionId String
  tagKey     String
  tagValue   String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([tagKey, tagValue])
}

// ——— Source material and ingestion ———

model SourceMaterial {
  id         String               @id @default(cuid())
  tenantId   String
  fileName   String
  fileKey    String               // storage path (S3/R2)
  mimeType   String               @default("application/pdf")
  pageCount  Int?
  status     SourceMaterialStatus @default(UPLOADED)
  uploadedBy String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader      User           @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  chunks        SourceChunk[]
  ingestionJobs IngestionJob[]

  @@index([tenantId])
  @@index([status])
}

model SourceChunk {
  id               String   @id @default(cuid())
  tenantId         String
  sourceMaterialId String
  pageIndex        Int
  chunkIndex       Int
  content          String   @db.Text
  // embedding    Uncomment when adding PgVector: Unsupported("vector(1536)")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source    SourceMaterial @relation(fields: [sourceMaterialId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([tenantId])
  @@index([sourceMaterialId])
}

model IngestionJob {
  id               String            @id @default(cuid())
  tenantId         String
  sourceMaterialId String
  jobType          IngestionJobType
  status           IngestionJobStatus @default(PENDING)
  payload          Json?
  result           Json?
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?           @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source  SourceMaterial @relation(fields: [sourceMaterialId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sourceMaterialId, jobType])
  @@index([status])
}

// ——— Exams and attempts ———

model ExamDefinition {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  examType        ExamType
  questionCount   Int
  subjectId       String?
  topicId        String?
  timeLimitMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ExamAttempt {
  id               String            @id @default(cuid())
  tenantId         String
  userId           String
  examType         ExamType
  questionCount    Int
  status           ExamAttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime          @default(now())
  submittedAt      DateTime?
  score            Float?            // null until submitted
  timeSpentSeconds Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ExamAttemptAnswer[]

  @@index([tenantId, userId])
  @@index([userId, submittedAt])
  @@index([status])
}

model ExamAttemptAnswer {
  id                String   @id @default(cuid())
  attemptId         String
  questionId        String
  selectedOptionId String
  isCorrect         Boolean
  timeSpentSeconds  Int?
  order             Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// ——— SRS ———

model SrsCard {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  questionId     String
  easeFactor    Float
  interval       Int      // days
  repetitions    Int      @default(0)
  nextReviewAt   DateTime
  lastReviewedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([tenantId, userId])
  @@index([userId, nextReviewAt])
}

// ——— Analytics (optional materialized) ———

model TopicPerformanceSnapshot {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  topicId       String
  attemptCount  Int      @default(0)
  correctCount  Int      @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([tenantId])
  @@index([userId])
}
